<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Byakaron.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Byakaron">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Win11 Fluent surface tokens, mirroring the macOS app, per theme:
                 use them with ThemeResource so light, dark and high contrast follow
                 the system (MainWindow.ThemeBrush for code). -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppSidebarBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="AppEditorBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppBarBrush" Color="#F9F9F9" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#E5E5E5" />
                    <SolidColorBrush x:Key="AppHairlineBrush" Color="#E0E0E0" />
                    <SolidColorBrush x:Key="AppMutedTextBrush" Color="#5C5C5C" />
                    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#8A8A8A" />
                    <SolidColorBrush x:Key="AppWarningBrush" Color="#CA5010" />
                    <SolidColorBrush x:Key="AppSuccessBrush" Color="#0F7B0F" />
                    <SolidColorBrush x:Key="AppIssueIconBrush" Color="#CA5010" />
                    <SolidColorBrush x:Key="AppBadgeBrush" Color="#E8E8E8" />
                    <SolidColorBrush x:Key="AppSelectedBrush" Color="#E8E8E8" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#005FB8" />
                    <!-- The suggestion pills: the keyboard's panel look (apps/windows/Keyboard/CandidateWindow.cpp). -->
                    <SolidColorBrush x:Key="AppPillBrush" Color="#F6F6F6" />
                    <SolidColorBrush x:Key="AppPillBorderBrush" Color="#1F000000" />
                    <SolidColorBrush x:Key="AppPillHoverBrush" Color="#17000000" />
                    <SolidColorBrush x:Key="AppPillSelectedBrush" Color="#0A84FF" />
                    <SolidColorBrush x:Key="AppPillTextBrush" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="AppPillSelectedTextBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppSidebarBrush" Color="#202020" />
                    <SolidColorBrush x:Key="AppEditorBrush" Color="#272727" />
                    <SolidColorBrush x:Key="AppBarBrush" Color="#2C2C2C" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="AppHairlineBrush" Color="#3D3D3D" />
                    <SolidColorBrush x:Key="AppMutedTextBrush" Color="#C5C5C5" />
                    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#9D9D9D" />
                    <SolidColorBrush x:Key="AppWarningBrush" Color="#F7894A" />
                    <SolidColorBrush x:Key="AppSuccessBrush" Color="#6CCB5F" />
                    <SolidColorBrush x:Key="AppIssueIconBrush" Color="#F7894A" />
                    <SolidColorBrush x:Key="AppBadgeBrush" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="AppSelectedBrush" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#60CDFF" />
                    <!-- The suggestion pills: the keyboard's panel look (apps/windows/Keyboard/CandidateWindow.cpp). -->
                    <SolidColorBrush x:Key="AppPillBrush" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="AppPillBorderBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="AppPillHoverBrush" Color="#17FFFFFF" />
                    <SolidColorBrush x:Key="AppPillSelectedBrush" Color="#0A84FF" />
                    <SolidColorBrush x:Key="AppPillTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppPillSelectedTextBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="AppSidebarBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AppEditorBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AppBarBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AppHairlineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AppMutedTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="AppWarningBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AppSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AppIssueIconBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AppBadgeBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AppSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <!-- The suggestion pills: the keyboard's panel look (apps/windows/Keyboard/CandidateWindow.cpp). -->
                    <SolidColorBrush x:Key="AppPillBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AppPillBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AppPillHoverBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="AppPillSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AppPillTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AppPillSelectedTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <x:Double x:Key="AppSidebarWidth">268</x:Double>
            <x:Double x:Key="AppTitleBarHeight">40</x:Double>

            <Style x:Key="TitleIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SuggestionChipStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="64" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="FontFamily" Value="Nirmala UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="QuietButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="72" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style x:Key="IssueListViewItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
