<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Byakaron.Settings.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    MinWidth="360"
    MaxWidth="440">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Padding="4,0,4,8">
            <StackPanel Spacing="8">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Typing" />
                <ToggleSwitch
                    x:Name="PhoneticOnlyToggle"
                    Header="Phonetic-only mode"
                    OffContent="Suggestions while typing"
                    OnContent="Hide suggestions"
                    Toggled="PhoneticOnlyToggle_Toggled" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    TextWrapping="Wrap"
                    Text="When on, the keyboard commits Avro phonetic only — no candidate list." />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Candidates" />
                <TextBlock
                    FontSize="13"
                    Text="List orientation" />
                <ComboBox
                    x:Name="OrientationCombo"
                    MinWidth="200"
                    SelectionChanged="OrientationCombo_SelectionChanged">
                    <ComboBoxItem Content="Horizontal" Tag="horizontal" />
                    <ComboBoxItem Content="Vertical" Tag="vertical" />
                </ComboBox>
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    TextWrapping="Wrap"
                    Text="Applies to the candidate popup the keyboard shows while you type." />

                <TextBlock
                    Margin="0,8,0,0"
                    FontSize="13"
                    Text="Candidates per page" />
                <Slider
                    x:Name="PerPageSlider"
                    Minimum="3"
                    Maximum="9"
                    StepFrequency="1"
                    TickFrequency="1"
                    ValueChanged="PerPageSlider_ValueChanged" />
                <TextBlock
                    x:Name="PerPageValueText"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
