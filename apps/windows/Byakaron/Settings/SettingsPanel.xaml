<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Byakaron.Settings.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="480">

    <UserControl.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="FieldTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <!-- The macOS app's Settings tabs: Setup, Typing, Suggestions, Personal
         dictionary and Layout, in that order. -->
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <SelectorBar x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
            <SelectorBarItem x:Name="SetupTab" Text="Setup" Tag="setup" IsSelected="True" />
            <SelectorBarItem x:Name="TypingTab" Text="Typing" Tag="typing" />
            <SelectorBarItem x:Name="CandidatesTab" Text="Suggestions" Tag="candidates" />
            <SelectorBarItem x:Name="DictionaryTab" Text="Dictionary" Tag="dictionary" />
            <SelectorBarItem x:Name="LayoutTab" Text="Layout" Tag="layout" />
            <SelectorBarItem x:Name="UpdatesTab" Text="Updates" Tag="updates" />
        </SelectorBar>

        <TextBlock
            x:Name="UnavailableText"
            Grid.Row="1"
            Visibility="Collapsed"
            FontSize="12"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            TextWrapping="Wrap"
            Text="Keyboard settings are unavailable: byakaron.dll could not be loaded." />

        <ScrollViewer Grid.Row="2" Height="460" VerticalScrollBarVisibility="Auto">
            <Grid Padding="4,0,12,8">
                <!-- Setup: install the keyboard, switch to it, how typing works. -->
                <StackPanel x:Name="SetupPage" Spacing="16">
                    <InfoBar x:Name="KeyboardStatusBar" IsOpen="True" IsClosable="False" />
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Set up" />
                        <StackPanel x:Name="SetupSteps" Spacing="10" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="InstallButton" Style="{StaticResource AccentButtonStyle}" Content="Install keyboard" Click="InstallButton_Click" />
                        <Button Content="Language settings" Click="LanguageSettings_Click" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Typing" />
                        <StackPanel x:Name="TypingTips" Spacing="6" />
                    </StackPanel>
                </StackPanel>

                <!-- The shared settings, one manifest section per tab, built at load. -->
                <StackPanel x:Name="TypingPage" Spacing="12" Visibility="Collapsed" />
                <StackPanel x:Name="CandidatesPage" Spacing="12" Visibility="Collapsed" />

                <StackPanel x:Name="DictionaryPage" Spacing="8" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Personal dictionary" />
                    <TextBlock Style="{StaticResource HintStyle}" Text="Your words are suggested after Avro's while you type." />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="NewWordBox"
                            PlaceholderText="Add a Bangla word"
                            KeyDown="NewWordBox_KeyDown" />
                        <Button
                            x:Name="AddWordButton"
                            Grid.Column="1"
                            Content="Add"
                            Click="AddWord_Click" />
                    </Grid>
                    <TextBlock
                        x:Name="WordStatusText"
                        Visibility="Collapsed"
                        Style="{StaticResource HintStyle}" />
                    <TextBlock
                        x:Name="UserWordsEmptyText"
                        Style="{StaticResource HintStyle}"
                        Text="No words yet." />
                    <StackPanel x:Name="UserWordsPanel" Spacing="2" />
                </StackPanel>

                <!-- The Avro phonetic key map. -->
                <StackPanel x:Name="LayoutPage" Spacing="16" Visibility="Collapsed" />

                <!-- Updates: the shared update settings, then Check Now. -->
                <StackPanel x:Name="UpdatesPage" Spacing="12" Visibility="Collapsed">
                    <StackPanel x:Name="UpdatesSettings" Spacing="12" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="UpdateButton" Content="Check now" Click="UpdateButton_Click" />
                        <ProgressRing x:Name="UpdateProgress" IsActive="False" Width="20" Height="20" />
                    </StackPanel>
                    <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
