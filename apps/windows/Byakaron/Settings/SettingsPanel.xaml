<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Byakaron.Settings.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    MinWidth="360"
    MaxWidth="440">

    <UserControl.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="FieldTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Padding="4,0,4,8">
            <TextBlock
                x:Name="UnavailableText"
                Visibility="Collapsed"
                FontSize="12"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Text="Keyboard settings are unavailable: byakaron_ffi.dll could not be loaded." />

            <!-- The shared settings, built from the core's manifest at load. -->
            <StackPanel x:Name="ManifestPanel" Spacing="20" />

            <StackPanel Spacing="8">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Personal dictionary" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    TextWrapping="Wrap"
                    Text="Your words are suggested after Avro's while you type." />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="NewWordBox"
                        PlaceholderText="Add a Bangla word" />
                    <Button
                        x:Name="AddWordButton"
                        Grid.Column="1"
                        Content="Add"
                        Click="AddWord_Click" />
                </Grid>
                <TextBlock
                    x:Name="WordStatusText"
                    Visibility="Collapsed"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="UserWordsEmptyText"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="No words yet." />
                <StackPanel x:Name="UserWordsPanel" Spacing="2" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
