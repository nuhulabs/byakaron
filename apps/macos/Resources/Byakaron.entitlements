<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- DEFAULT: Byakaron ships non-sandboxed so it can install the keyboard
         automatically (KeyboardInstaller.ensureInstalled copies it into
         ~/Library/Input Methods and registers it).

         To build the sandboxed variant instead — which relies on the manual
         "Reveal Keyboard" flow — sign with Byakaron-sandboxed.entitlements
         (zig build macos -Dmacos-config=sandboxed). -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
</dict>
</plist>
