<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- OPTIONAL: the sandboxed app variant. Sign the main app with this file
         (zig build macos -Dmacos-config=sandboxed) when you want the App Store-style sandbox.

         A sandboxed app can't copy/register the keyboard itself, so users install
         it via the Setup guide's "Reveal Keyboard" button and drag it into
         ~/Library/Input Methods.

         NOTE: sandboxed, the app sees its container's Application Support, not
         the ~/Library/Application Support/Byakaron the keyboard reads, so
         Settings would not reach the keyboard. To keep them in sync, move both to
         an App Group (com.apple.security.application-groups) and point
         ByakaronSettings.dataDirectory at the group container. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- UpdateChecker reaches GitHub's releases API. -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
