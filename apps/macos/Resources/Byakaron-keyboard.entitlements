<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The keyboard is installed manually into ~/Library/Input Methods and runs
         as a standalone input method, NOT inside the app's sandbox. Keep it
         unsandboxed so it can read the shared settings suite the app writes and
         operate as a system-wide IME.

         NOTE: with the app sandboxed and the keyboard unsandboxed, the named
         UserDefaults suite no longer resolves to the same plist for both
         processes. To keep Settings syncing to the keyboard, move both to an App
         Group (com.apple.security.application-groups) and point
         ByakaronSettings.suiteName at the group id. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
</dict>
</plist>
