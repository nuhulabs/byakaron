<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The keyboard is installed manually into ~/Library/Input Methods and runs
         as a standalone input method, NOT inside the app's sandbox. Keep it
         unsandboxed so it can read the settings the app saves in
         ~/Library/Application Support/Byakaron and operate as a system-wide IME.

         NOTE: a sandboxed app sees its container's Application Support instead,
         so its Settings would not reach the keyboard. To keep them in sync, move
         both to an App Group (com.apple.security.application-groups) and point
         ByakaronSettings.dataDirectory at the group container. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
</dict>
</plist>
