{
	"$schema": "https://cdn.jsdelivr.net/npm/wrangler/config-schema.json",
	"name": "byakaron",
	"main": "main.ts",
	"compatibility_date": "2026-03-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "746e11ca0575404aa194c723c7b664d5",
		},
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "byakaron",
			"migrations_dir": "../../zig-out/d1",
			"database_id": "8ccbd65d-60a1-43d8-b01a-ddba1431cfa1"
		}
	],
	"build": {
		"watch_dir": "./app",
		"command": "zig build zx -- build --target=wasm32-wasi --release=small --prerender"
	},
	"assets": {
		"directory": "../../zig-out/static",
		"binding": "ASSETS"
	},
	"observability": {
		"logs": {
			"enabled": false,
			"invocation_logs": true
		}
	}
}