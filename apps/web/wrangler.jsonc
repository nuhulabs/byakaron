{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "byakaron",
	"main": "main.ts",
	"compatibility_date": "2026-03-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Fill in the ids printed by `wrangler kv namespace create byakaron` and
	// `wrangler d1 create byakaron` (see README.md → Cloudflare).
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "746e11ca0575404aa194c723c7b664d5",
		},
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "byakaron",
			// spell.db as migrations, written by `zig build d1`.
			"migrations_dir": "../../zig-out/d1",
			"database_id": "8ccbd65d-60a1-43d8-b01a-ddba1431cfa1",
		}
	],
	"build": {
		"watch_dir": "./app",
		"command": "cd ../.. && zig build -Dtarget=wasm32-wasi --release=small",
	},
	"assets": {
		"directory": "../../zig-out/static",
		"binding": "ASSETS",
	},
	"observability": {
		"logs": {
			"enabled": false,
			"invocation_logs": true
		}
	}
}