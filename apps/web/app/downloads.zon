.{
    // Public site origin for one-line installers (/install.sh, /install.ps1).
    .site = "https://nuhulabs.com/byakaron",
    // Stable asset names on nuhulabs/Byakaron-Assets. Links use
    // /releases/latest/download/<file> so this catalog does not need a
    // per-release refresh.
    .repo = "nuhulabs/Byakaron-Assets",
    // Store listings. An empty string means not listed yet (shown as "Coming
    // soon" on the landing page).
    .stores = .{
        .android = "https://play.google.com/store/apps/details?id=com.nuhulabs.byakaron",
        .ios = "",
    },
    .assets = .{
        .{
            .id = "macos",
            .label = "macOS",
            .detail = "Apple Silicon & Intel · .dmg",
            .file = "Byakaron.dmg",
        },
        .{
            .id = "windows",
            .label = "Windows",
            .detail = "x64 installer · .exe",
            .file = "Byakaron-Setup.exe",
        },
        .{
            .id = "linux_amd64",
            .label = "Linux (amd64)",
            .detail = "Ubuntu / Debian · .deb",
            .file = "byakaron_amd64.deb",
        },
        .{
            .id = "linux_arm64",
            .label = "Linux (arm64)",
            .detail = "Ubuntu / Debian · .deb",
            .file = "byakaron_arm64.deb",
        },
        .{
            .id = "linux_arch",
            .label = "Arch Linux (x86_64)",
            .detail = "pacman · .pkg.tar.zst",
            .file = "byakaron_x86_64.pkg.tar.zst",
        },
        .{
            .id = "android_apk",
            .label = "Android (APK)",
            .detail = "Sideload · .apk",
            .file = "Byakaron.apk",
        },
        .{
            .id = "android_aab",
            .label = "Android (Play bundle)",
            .detail = "Play Store · .aab",
            .file = "Byakaron.aab",
        },
    },
}
