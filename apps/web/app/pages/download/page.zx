//! Public download page. Installers are served from Cloudflare R2 via
//! `/downloads/<file>` (see `apps/web/main.ts`) — not from the private GitHub
//! release — so anonymous visitors can still get the builds.

const std = @import("std");
const zx = @import("zx");

const Catalog = struct {
    version: []const u8,
    tag: []const u8,
    assets: []const Asset,
};
const Asset = struct {
    id: []const u8,
    label: []const u8,
    detail: []const u8,
    file: []const u8,
    sha256: []const u8,
};

const catalog: Catalog = @import("../../downloads.zon");

pub fn Page(ctx: zx.PageContext) !zx.Component {
    const title = try std.fmt.allocPrint(ctx.arena, "Byakaron {s}", .{catalog.version});
    const notes = try std.fmt.allocPrint(ctx.arena, "https://github.com/nuhulabs/byakaron/releases/tag/{s}", .{catalog.tag});
    return (
        <main @allocator={ctx.arena} class="dl-shell">
            <header class="dl-hero">
                <p class="dl-brand">byakaron</p>
                <h1 class="dl-title">{title}</h1>
                <p class="dl-lead">Installers for every platform. Files are served from our CDN — no GitHub login required.</p>
                <p class="dl-nav">
                    <a href="/">Spell check</a>
                    <span aria-hidden="true">·</span>
                    <a href={notes}>Release notes</a>
                </p>
            </header>

            <ul class="dl-list">
                {for (catalog.assets) |asset| (
                    <li class="dl-item">
                        <div class="dl-meta">
                            <h2 class="dl-label">{asset.label}</h2>
                            <p class="dl-detail">{asset.detail}</p>
                            <p class="dl-hash">sha256:{asset.sha256}</p>
                        </div>
                        <a class="dl-btn" href={try std.fmt.allocPrint(ctx.arena, "/downloads/{s}", .{asset.file})} download={asset.file}>
                            Download
                        </a>
                    </li>
                )}
            </ul>
        </main>
    );
}

pub const options: zx.PageOptions = .{
    .rendering = .prerendered,
};
