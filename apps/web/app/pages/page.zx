//! Landing page. Every platform has a card; `/site.js` tags `<html>` with
//! the visitor's OS (`data-os`) so CSS can lift that card to the top and swap
//! the hero button to its store listing or installer. Without JavaScript the
//! hero offers the web app and every card stays reachable.
//! Icons are single-colour SVGs in `app/public/icons/`, drawn with CSS masks
//! (`.ic-<name>`) so they take the text colour.
//! The spell checker itself lives at `/app`.

const std = @import("std");
const zx = @import("zx");
const Catalog = @import("../catalog.zig");
const catalog = Catalog.catalog;

/// One icon button on a platform card. An empty `href` renders disabled
/// ("coming soon").
const Action = struct {
    /// `ic-<name>` class, an SVG in `app/public/icons/`.
    icon: []const u8,
    /// Tooltip and accessible name.
    tip: []const u8,
    href: []const u8,
    /// Set when `href` is an installer rather than a page.
    file: []const u8 = "",
    primary: bool = false,
};

const Platform = struct {
    /// Matches the `data-os` value `/site.js` sets.
    id: []const u8,
    name: []const u8,
    icon: []const u8,
    detail: []const u8,
    /// Hero button for visitors on this platform.
    cta: []const u8,
    cta_icon: []const u8,
    cta_href: []const u8,
    /// Card buttons, secondary first: the primary one is always rightmost.
    actions: []const Action,
};

const Feature = struct {
    icon: []const u8,
    title: []const u8,
    body: []const u8,
};

const features = [_]Feature{
    .{ .icon = "ic-check", .title = "Spell check", .body = "Finds misspellings and offers the right word." },
    .{ .icon = "ic-spark", .title = "Suggestions as you type", .body = "Words and corrections in the keyboard." },
    .{ .icon = "ic-offline", .title = "Works offline", .body = "The dictionary ships inside the apps." },
    .{ .icon = "ic-devices", .title = "On every device", .body = "Desktop, phone and the web." },
};

fn platforms(arena: std.mem.Allocator) ![]const Platform {
    const dmg = try Catalog.latest(arena, "Byakaron.dmg");
    const exe = try Catalog.latest(arena, "Byakaron-Setup.exe");
    const deb = try Catalog.latest(arena, "byakaron_amd64.deb");
    const apk = try Catalog.latest(arena, "Byakaron.apk");
    const play = catalog.stores.android;
    const app_store = catalog.stores.ios;
    return arena.dupe(Platform, &.{
        .{
            .id = "macos",
            .name = "macOS",
            .icon = "ic-apple",
            .detail = "Apple Silicon and Intel",
            .cta = "Download for macOS",
            .cta_icon = "ic-apple",
            .cta_href = dmg,
            .actions = try arena.dupe(Action, &.{
                .{ .icon = "ic-download", .tip = "Download Byakaron.dmg", .href = dmg, .file = "Byakaron.dmg", .primary = true },
            }),
        },
        .{
            .id = "windows",
            .name = "Windows",
            .icon = "ic-windows",
            .detail = "Windows 10 and 11, x64",
            .cta = "Download for Windows",
            .cta_icon = "ic-windows",
            .cta_href = exe,
            .actions = try arena.dupe(Action, &.{
                .{ .icon = "ic-download", .tip = "Download Byakaron-Setup.exe", .href = exe, .file = "Byakaron-Setup.exe", .primary = true },
            }),
        },
        .{
            .id = "linux",
            .name = "Linux",
            .icon = "ic-linux",
            .detail = "Ubuntu, Debian and Arch",
            .cta = "Download for Linux",
            .cta_icon = "ic-linux",
            .cta_href = deb,
            .actions = try arena.dupe(Action, &.{
                .{ .icon = "ic-more", .tip = "arm64, Arch and other packages", .href = "/download" },
                .{ .icon = "ic-download", .tip = "Download the .deb (amd64)", .href = deb, .file = "byakaron_amd64.deb", .primary = true },
            }),
        },
        .{
            .id = "android",
            .name = "Android",
            .icon = "ic-android",
            .detail = "Byakaron Keyboard",
            .cta = "Get it on Google Play",
            .cta_icon = "ic-googleplay",
            .cta_href = if (play.len > 0) play else apk,
            .actions = try arena.dupe(Action, &.{
                .{ .icon = "ic-download", .tip = "Download the APK", .href = apk, .file = "Byakaron.apk" },
                .{ .icon = "ic-googleplay", .tip = "Get it on Google Play", .href = play, .primary = true },
            }),
        },
        .{
            .id = "ios",
            .name = "iPhone and iPad",
            .icon = "ic-apple",
            .detail = "Coming to the App Store",
            .cta = if (app_store.len > 0) "Download on the App Store" else "Open the web app",
            .cta_icon = if (app_store.len > 0) "ic-appstore" else "ic-globe",
            .cta_href = if (app_store.len > 0) app_store else "/app",
            .actions = try arena.dupe(Action, &.{
                .{ .icon = "ic-globe", .tip = "Open the web app meanwhile", .href = "/app" },
                .{ .icon = "ic-appstore", .tip = if (app_store.len > 0) "Download on the App Store" else "App Store: coming soon", .href = app_store, .primary = true },
            }),
        },
        .{
            .id = "web",
            .name = "Web",
            .icon = "ic-globe",
            .detail = "Any browser, nothing to install",
            .cta = "Open the web app",
            .cta_icon = "ic-globe",
            .cta_href = "/app",
            .actions = try arena.dupe(Action, &.{
                .{ .icon = "ic-arrow", .tip = "Open the web app", .href = "/app", .primary = true },
            }),
        },
    });
}

/// Bangla letters scattered behind the hero's right side (decoration only).
const Glyph = struct { ch: []const u8, x: u8, y: u8, size: f32, rot: i16 };
const glyphs = [_]Glyph{
    .{ .ch = "অ", .x = 6, .y = 8, .size = 3.2, .rot = -12 },
    .{ .ch = "ক", .x = 30, .y = 2, .size = 2.2, .rot = 8 },
    .{ .ch = "ব", .x = 58, .y = 6, .size = 4.2, .rot = -6 },
    .{ .ch = "ং", .x = 86, .y = 12, .size = 2.4, .rot = 14 },
    .{ .ch = "শ", .x = 92, .y = 40, .size = 3.4, .rot = -10 },
    .{ .ch = "য", .x = 2, .y = 46, .size = 2.6, .rot = 10 },
    .{ .ch = "ঞ", .x = 80, .y = 70, .size = 2.8, .rot = 6 },
    .{ .ch = "ৎ", .x = 14, .y = 82, .size = 3.0, .rot = -14 },
    .{ .ch = "ড়", .x = 44, .y = 90, .size = 2.2, .rot = 12 },
    .{ .ch = "ঋ", .x = 64, .y = 84, .size = 3.6, .rot = -4 },
    .{ .ch = "ঘ", .x = 96, .y = 88, .size = 2.0, .rot = -16 },
    .{ .ch = "ই", .x = 40, .y = 30, .size = 1.8, .rot = 18 },
    .{ .ch = "আ", .x = 72, .y = 32, .size = 1.9, .rot = -8 },
    .{ .ch = "ঙ", .x = 22, .y = 26, .size = 1.7, .rot = 4 },
};

/// Tabs of the terminal install box; `/site.js` checks the visitor's.
const Terminal = struct {
    /// `lp-term-<data-os>`.
    id: []const u8,
    name: []const u8,
    icon: []const u8,
    prompt: []const u8,
    note: []const u8,
    script: []const u8,
    windows: bool = false,
    default: bool = false,
};

const terminals = [_]Terminal{
    .{ .id = "lp-term-macos", .name = "macOS", .icon = "ic-apple", .prompt = "$", .note = "Installs Byakaron.app into Applications. Script:", .script = "/install.sh", .default = true },
    .{ .id = "lp-term-linux", .name = "Linux", .icon = "ic-linux", .prompt = "$", .note = "Ubuntu, Debian or Arch Linux. Script:", .script = "/install.sh" },
    .{ .id = "lp-term-windows", .name = "Windows", .icon = "ic-windows", .prompt = "PS>", .note = "In PowerShell; runs the quiet Setup.exe. Script:", .script = "/install.ps1", .windows = true },
};

pub fn Page(ctx: zx.PageContext) !zx.Component {
    const list = try platforms(ctx.arena);
    const notes = try std.fmt.allocPrint(ctx.arena, "https://github.com/{s}/releases/latest", .{catalog.repo});
    const unix_cmd = try std.fmt.allocPrint(ctx.arena, "curl -fsSL {s}/install.sh | bash", .{catalog.site});
    const win_cmd = try std.fmt.allocPrint(ctx.arena, "irm {s}/install.ps1 | iex", .{catalog.site});
    return (
        <main @allocator={ctx.arena} class="lp">
            <script src="/site.js"></script>
            <nav class="lp-nav">
                <a class="lp-logo" href="/">
                    <img src="/logo.svg" alt="" width="32" height="32" />
                    <span class="lp-logo-name">Byakaron<span class="lp-logo-sep" aria-hidden="true">|</span><span lang="bn">ব্যাকারন</span></span>
                </a>
                <div class="lp-nav-links">
                    <a href="/app">Web app</a>
                    <a href="/download">Downloads</a>
                </div>
            </nav>

            <header class="lp-hero">
                <div class="lp-hero-copy">
                    <p class="lp-eyebrow">বাংলা কিবোর্ড ও বানান পরীক্ষক</p>
                    <h1 class="lp-title">বাংলা লিখুন, নির্ভুল বানানে।</h1>
                    <p class="lp-lead">A Bangla keyboard and spell checker for every device you write on: your laptop, your phone and the browser.</p>
                    <div class="lp-actions">
                        {for (list) |p| (
                            <a class="lp-cta" data-for={p.id} href={p.cta_href}>
                                <span class={p.cta_icon} aria-hidden="true"></span>
                                {p.cta}
                            </a>
                        )}
                        <a class="lp-secondary" href="/download">All downloads</a>
                    </div>
                </div>
                <div class="lp-glyphs" aria-hidden="true">
                    {for (glyphs) |g| (
                        <span style={try std.fmt.allocPrint(ctx.arena, "left:{d}%;top:{d}%;font-size:{d}rem;transform:translate(-50%,-50%) rotate({d}deg)", .{ g.x, g.y, g.size, g.rot })}>{g.ch}</span>
                    )}
                </div>
                <div class="lp-demo" aria-hidden="true">
                    <div class="lp-demo-bar">
                        <i></i>
                        <i></i>
                        <i></i>
                        <img src="/logo.svg" alt="" width="16" height="16" />
                    </div>
                    <p class="lp-demo-text">
                        আমি প্রতিদিন
                        <mark>
                            সুদ্ধ
                            <span class="lp-demo-pop">
                                <span class="lp-demo-label">বানান ঠিক করুন</span>
                                <span class="lp-demo-pick">শুদ্ধ</span>
                                <span>শুদ্ধি</span>
                            </span>
                        </mark>
                        বাংলায় লিখি।
                    </p>
                </div>
            </header>

            <section class="lp-features" aria-label="Features">
                {for (features) |f| (
                    <div class="lp-feature">
                        <span class={f.icon} aria-hidden="true"></span>
                        <div>
                            <h3>{f.title}</h3>
                            <p>{f.body}</p>
                        </div>
                    </div>
                )}
            </section>

            <section class="lp-platforms" aria-labelledby="lp-platforms-title">
                <h2 id="lp-platforms-title" class="lp-section-title">Get Byakaron</h2>
                <p class="lp-section-lead">Pick your platform. Downloads always point at the latest release.</p>
                <ul class="lp-grid">
                    {for (list) |p| (
                        <li class="lp-card" data-for={p.id}>
                            <span class={p.icon} aria-hidden="true"></span>
                            <div class="lp-card-body">
                                <h3 class="lp-card-name">
                                    {p.name}
                                    <span class="lp-badge">This device</span>
                                </h3>
                                <p class="lp-card-detail">{p.detail}</p>
                            </div>
                            <div class="lp-card-actions">
                                {for (p.actions) |a| (
                                    <span class={if (a.primary) "lp-tip is-primary" else "lp-tip"} data-tip={a.tip}>
                                        {if (a.href.len == 0) (
                                            <span class="lp-icon-btn is-soon" role="link" aria-disabled="true" aria-label={a.tip}>
                                                <span class={a.icon} aria-hidden="true"></span>
                                            </span>
                                        ) else if (a.file.len > 0) (
                                            <a class="lp-icon-btn" href={a.href} download={a.file} aria-label={a.tip}>
                                                <span class={a.icon} aria-hidden="true"></span>
                                            </a>
                                        ) else (
                                            <a class="lp-icon-btn" href={a.href} aria-label={a.tip}>
                                                <span class={a.icon} aria-hidden="true"></span>
                                            </a>
                                        )}
                                    </span>
                                )}
                            </div>
                        </li>
                    )}
                </ul>
            </section>

            <section class="lp-install" aria-labelledby="lp-install-title">
                <h2 id="lp-install-title" class="lp-section-title">Or install from a terminal</h2>
                <p class="lp-section-lead">One command picks the right package for your machine.</p>
                <div class="lp-term">
                    {for (terminals) |t| (
                        <input class="lp-term-radio" type="radio" name="lp-term" id={t.id} checked={t.default} />
                    )}
                    <div class="lp-term-bar">
                        <span class="lp-term-dots" aria-hidden="true">
                            <i></i>
                            <i></i>
                            <i></i>
                        </span>
                        <div class="lp-term-tabs">
                            {for (terminals) |t| (
                                <label for={t.id}>
                                    <span class={t.icon} aria-hidden="true"></span>
                                    {t.name}
                                </label>
                            )}
                        </div>
                    </div>
                    {for (terminals) |t| (
                        <div class="lp-term-pane" data-tab={t.id}>
                            <pre><code><span class="lp-term-prompt" aria-hidden="true">{t.prompt}</span>{if (t.windows) win_cmd else unix_cmd}</code></pre>
                            <p class="lp-term-note">
                                {t.note}
                                <a href={t.script}>{t.script[1..]}</a>
                            </p>
                        </div>
                    )}
                </div>
            </section>

            <footer class="lp-footer">
                <a class="lp-logo" href="/">
                    <img src="/logo.svg" alt="" width="22" height="22" />
                    <span class="lp-logo-name">Byakaron<span class="lp-logo-sep" aria-hidden="true">|</span><span lang="bn">ব্যাকারন</span></span>
                </a>
                <div class="lp-footer-links">
                    <a href="/app">Web app</a>
                    <a href="/download">Downloads</a>
                    <a href={notes}>Release notes</a>
                    <a href="/policy">Privacy</a>
                </div>
            </footer>
        </main>
    );
}

pub const options: zx.PageOptions = .{
    .rendering = .prerendered,
};
