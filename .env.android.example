# ==============================================================================
# Byakaron Android Environment Variables & Secrets Template
# ==============================================================================
# Copy this file to .env.android (or .env) and fill in your confidential secrets.
# DO NOT COMMIT .env OR .env.android TO VERSION CONTROL.
# ==============================================================================

# ── 1. Android Release Keystore & Signing ────────────────────────────────────
# Used by Gradle and GitHub Actions to sign release APKs and AABs.
# Generate base64 with: base64 -w 0 path/to/release-upload.jks
ANDROID_KEYSTORE_BASE64="<YOUR_BASE64_ENCODED_RELEASE_JKS>"
RELEASE_STORE_FILE="release-upload.jks"
RELEASE_STORE_PASSWORD="<YOUR_KEYSTORE_PASSWORD>"
RELEASE_KEY_ALIAS="release"
RELEASE_KEY_PASSWORD="<YOUR_KEY_PASSWORD>"

# ── 2. Google Play Store Deployment (CI / Fastlane) ─────────────────────────
# Service account JSON key generated from Google Cloud Console with Google Play
# Android Developer API permissions. Paste the entire JSON as a single line or string.
PLAY_STORE_PACKAGE_NAME="com.nuhulabs.byakaron"
PLAY_STORE_JSON_KEY='{"type": "service_account", "project_id": "...", "private_key": "...", "client_email": "..."}'
PLAY_STORE_TRACK="internal"  # Options: internal, alpha, beta, production
PLAY_STORE_STATUS="completed"  # Options: completed, draft, inProgress

# ── 3. GitHub Actions & Submodule Access ─────────────────────────────────────
# Private SSH Deploy Key with read access to nuhulabs/byakaron-android
ANDROID_DEPLOY_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"

# Personal Access Token (PAT) with repo/releases scope for nuhulabs/Byakaron-Assets
BYAKARON_ASSETS_TOKEN="ghp_..."

# ── 4. Local Development Paths ───────────────────────────────────────────────
ANDROID_HOME="/home/itshimelz/Android/Sdk"
ANDROID_SDK_ROOT="/home/itshimelz/Android/Sdk"
