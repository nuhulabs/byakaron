// Settings and menu labels every Byakaron app shares (macOS, Linux, web,
// Android). src/build/locale.zig turns each locale file into what each
// platform reads: a C header (Linux, and Swift through the bridging header),
// a Zig module (web) and Android string resources.
//
// Every locale file (listed in Locale.zig) must have exactly these keys; the
// `zig build test` check fails otherwise. Values are plain text: no format
// specifiers, no markup.
.{
    // Pages and tabs.
    .setup = "Setup",
    .layout = "Layout",
    .settings = "Settings",

    // Typing settings.
    .typing = "Typing",
    .typing_hint = "The keyboard picks these up from the next word you type.",
    .suggestions = "Word suggestions",
    .suggestions_hint = "Avro dictionary mode. Off is phonetic mode: every word is typed exactly as spelled, with no list.",
    .spelling_corrections = "Spelling corrections",
    .spelling_corrections_hint = "When a word comes out misspelled (sonar → সনার), suggest the correct one (সোনার).",
    .learn_choices = "Remember my choices",
    .learn_choices_hint = "The suggestion you picked for a word is highlighted first next time.",
    .bangla_digits = "Bangla digits",
    .bangla_digits_hint = "0–9 type ০–৯. Number keys still pick a suggestion while the list is showing.",
    .newline_on_enter = "New line on Enter",
    .newline_on_enter_hint = "Enter commits the word and also starts a new line. Off commits only.",

    // Candidate list.
    .candidates = "Candidates",
    .candidates_hint = "Applies to the candidate list the keyboard shows while you type.",
    .candidate_orientation = "Candidate list",
    .candidate_orientation_hint = "How the candidates are laid out.",
    .horizontal = "Horizontal",
    .vertical = "Vertical",
    .candidates_per_page = "Candidates per page",

    // Personal dictionary.
    .personal_dictionary = "Personal dictionary",
    .personal_dictionary_hint = "Words you saved as correct. They are never marked as misspelled and the keyboard suggests them.",
    .add_word = "Add a word",
    .add = "Add",
    .remove = "Remove",
    .no_words = "No words yet",
}
