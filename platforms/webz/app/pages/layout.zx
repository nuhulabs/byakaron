pub fn Layout(ctx: zx.LayoutContext, children: zx.Component) zx.Component {
    return (
        <html @allocator={ctx.arena} lang="bn">
            <head>
                <meta charset="UTF-8" />
                <meta name="viewport" content="width=device-width, initial-scale=1.0" />
                <title>byakaron | বাংলা বানান</title>
                <link rel="preconnect" href="https://fonts.googleapis.com" />
                <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
                <link href="https://fonts.googleapis.com/css2?family=Anek+Bangla:wght@400;600;700&family=Syne:wght@600;700&display=swap" rel="stylesheet" />
                <link rel="stylesheet" href="/assets/style.css" />
            </head>
            <body>
                {children}
            </body>
        </html>
    );
}

const zx = @import("zx");
