pub fn Page(ctx: zx.PageContext) !zx.Component {
    var text = try readInputText(ctx);
    text = try applyActions(ctx, text);

    const results = if (text.len > 0)
        try spell.checkText(ctx.arena, text)
    else
        @as([]const spell.TokenResult, &.{});

    const issues = try collectIssues(ctx.arena, results);
    const unknown_count = issues.len;
    const selected_issue = clampIndex(readIssueIndex(ctx), unknown_count);
    const selected = if (unknown_count > 0) issues[selected_issue] else null;

    const word_count = results.len;
    const char_count = utf8Codepoints(text);

    return (
        <main @allocator={ctx.arena} class="app-shell">
            <form class="app-layout" method="post" action="/">
                <aside class="sidebar">
                    <h2 class="sidebar-title">Issues ({unknown_count})</h2>
                    <div class="issue-list">
                        {if (unknown_count == 0) (
                            <p class="issue-empty">No issues yet</p>
                        )}
                        {for (issues) |issue| (
                            <button
                                class={if (issue.ordinal == selected_issue) "issue-item is-active" else "issue-item"}
                                type="submit"
                                name="issue"
                                value={issue.ordinal}
                            >
                                <span class="issue-icon" aria-hidden="true"></span>
                                <span class="issue-word">{issue.token}</span>
                                <span class="issue-count">{issue.suggestion_count}</span>
                            </button>
                        )}
                    </div>
                </aside>

                <section class="main-pane">
                    <header class="main-header">
                        <div class="brand-block">
                            <h1 class="brand">Byakaron</h1>
                            <p class="brand-meta">{word_count} words · {unknown_count} issues</p>
                        </div>
                        <div class="toolbar">
                            <button class="tool-btn" type="submit" name="action" value="check" title="Check spelling" aria-label="Check spelling">
                                <span class="icon-wand" aria-hidden="true"></span>
                            </button>
                            <button class="tool-btn" type="submit" name="action" value="clear" title="Clear" aria-label="Clear">
                                <span class="icon-trash" aria-hidden="true"></span>
                            </button>
                        </div>
                    </header>

                    <input type="hidden" name="issue" value={selected_issue} />

                    <div class="editor">
                        {if (results.len > 0) (
                            <div class="editor-backdrop" aria-hidden="true">
                                {for (results) |r| (
                                    <span class={if (r.known) "tok" else "tok tok-bad"}>{r.token}</span>
                                )}
                            </div>
                        )}
                        <SpellEditor text={text} @rendering={.client} />
                    </div>

                    {if (selected) |sel| (
                        <div class="fix-bar">
                            <div class="fix-target">
                                <span class="fix-word">{sel.token}</span>
                                <span class="fix-label">Replace with</span>
                            </div>
                            <div class="fix-chips">
                                {if (sel.suggestions.len == 0) (
                                    <span class="fix-none">No suggestions</span>
                                )}
                                {for (sel.suggestions) |s| (
                                    <button class="fix-chip" type="submit" name="replace" value={s.word}>{s.word}</button>
                                )}
                            </div>
                            <button class="fix-ignore" type="submit" name="action" value="ignore">Ignore</button>
                        </div>
                    )}
                    {if (selected == null and text.len > 0) (
                        <div class="fix-bar fix-bar-ok">
                            <span class="fix-ok">All words look good.</span>
                            <button class="fix-ignore" type="submit" name="action" value="check">Recheck</button>
                        </div>
                    )}

                    <footer class="status-bar">
                        <div class="status-left">
                            <span class="stat">
                                <span class="icon-list" aria-hidden="true"></span>
                                {word_count} words
                            </span>
                            <span class="stat">
                                <span class="icon-char" aria-hidden="true"></span>
                                {char_count} characters
                            </span>
                        </div>
                        <div class="status-right">
                            <span class={if (unknown_count > 0) "stat stat-warn" else "stat"}>
                                <span class="icon-warn" aria-hidden="true"></span>
                                {unknown_count} issues
                            </span>
                        </div>
                    </footer>
                </section>
            </form>
        </main>
    );
}

pub fn SpellEditor(ctx: *zx.ComponentCtx(struct { text: []const u8 })) zx.Component {
    const text = ctx.state([]const u8, ctx.props.text);

    return (
        <textarea
            @allocator={ctx.allocator}
            id="text"
            class="editor-input"
            name="text"
            rows="8"
            autofocus
            placeholder="এখানে বাংলা লিখুন…"
            spellcheck="false"
            onchange={ctx.bind(onTextChange)}
        >{text.get()}</textarea>
    );
}

fn onTextChange(e: *zx.server.Event.Stateful) void {
    const text = e.state([]const u8);
    text.set(e.value() orelse "");
}

fn readInputText(ctx: zx.PageContext) ![]const u8 {
    if (ctx.request.method == .POST) {
        const form = ctx.request.formData();
        if (form.get("text")) |t| return std.mem.trim(u8, t, " \t\r\n");
    }
    if (ctx.request.queries.get("q")) |q| return std.mem.trim(u8, q, " \t\r\n");
    return "";
}

fn readIssueIndex(ctx: zx.PageContext) usize {
    const raw = blk: {
        if (ctx.request.method == .POST) {
            const form = ctx.request.formData();
            if (form.get("issue")) |v| break :blk v;
        }
        if (ctx.request.queries.get("issue")) |v| break :blk v;
        break :blk "0";
    };
    return std.fmt.parseInt(usize, raw, 10) catch 0;
}

fn applyActions(ctx: zx.PageContext, text: []const u8) ![]const u8 {
    if (ctx.request.method != .POST) return text;
    const form = ctx.request.formData();

    if (form.get("action")) |action| {
        if (std.mem.eql(u8, action, "clear")) return "";
        if (std.mem.eql(u8, action, "ignore")) return text;
        if (std.mem.eql(u8, action, "check")) return text;
    }

    if (form.get("replace")) |replacement| {
        if (text.len == 0) return text;
        const results = try spell.checkText(ctx.arena, text);
        var unknown_count: usize = 0;
        for (results) |r| {
            if (!r.known) unknown_count += 1;
        }
        const selected_issue = clampIndex(readIssueIndex(ctx), unknown_count);
        const issues = try collectIssues(ctx.arena, results);
        if (selected_issue < issues.len) {
            const sel = issues[selected_issue];
            return try replaceNthToken(ctx.arena, text, results, sel.token, selected_issue, replacement);
        }
    }

    return text;
}

const Issue = struct {
    ordinal: usize,
    token: []const u8,
    suggestion_count: usize,
    suggestions: []const spell.Suggestion,
};

fn collectIssues(allocator: std.mem.Allocator, results: []const spell.TokenResult) ![]const Issue {
    var list: std.ArrayList(Issue) = .empty;
    errdefer list.deinit(allocator);
    var n: usize = 0;
    for (results) |r| {
        if (!r.known) {
            try list.append(allocator, .{
                .ordinal = n,
                .token = r.token,
                .suggestion_count = r.suggestions.len,
                .suggestions = r.suggestions,
            });
            n += 1;
        }
    }
    return try list.toOwnedSlice(allocator);
}

fn clampIndex(idx: usize, count: usize) usize {
    if (count == 0) return 0;
    if (idx >= count) return count - 1;
    return idx;
}

fn replaceNthToken(
    allocator: std.mem.Allocator,
    text: []const u8,
    results: []const spell.TokenResult,
    target: []const u8,
    unknown_ordinal: usize,
    replacement: []const u8,
) ![]const u8 {
    _ = text;
    var out: std.ArrayList(u8) = .empty;
    errdefer out.deinit(allocator);

    var seen: usize = 0;
    var first = true;
    for (results) |r| {
        if (!first) try out.append(allocator, ' ');
        first = false;

        const is_target = !r.known and std.mem.eql(u8, r.token, target);
        if (is_target) {
            if (seen == unknown_ordinal) {
                try out.appendSlice(allocator, replacement);
            } else {
                try out.appendSlice(allocator, r.token);
            }
            seen += 1;
        } else {
            try out.appendSlice(allocator, r.token);
        }
    }
    return try out.toOwnedSlice(allocator);
}

fn utf8Codepoints(text: []const u8) usize {
    return std.unicode.utf8CountCodepoints(text) catch text.len;
}

pub const options: zx.PageOptions = .{
    .methods = &.{ .GET, .POST },
    .dynamic = true,
};

const std = @import("std");
const zx = @import("zx");
const spell = @import("./spell.zig");
