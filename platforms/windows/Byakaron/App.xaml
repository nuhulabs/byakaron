<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Byakaron.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Byakaron">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#F7F7F7" />
            <SolidColorBrush x:Key="AppPanelBrush" Color="#F2F2F2" />
            <SolidColorBrush x:Key="AppCardBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="#D9D9D9" />
            <SolidColorBrush x:Key="AppMutedTextBrush" Color="#6B6B6B" />
            <SolidColorBrush x:Key="AppWarningBrush" Color="#D77800" />
            <SolidColorBrush x:Key="AppIssueBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="AppSelectedBrush" Color="#EAF3FF" />
            <SolidColorBrush x:Key="AppSelectedStrokeBrush" Color="#0067C0" />

            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SuggestionButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="68" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="FontFamily" Value="Nirmala UI" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <!-- Theme resource definitions for WinUI 3 compatibility -->
            <SolidColorBrush x:Key="SystemControlBorderBrush" Color="#FF3F3F3F" />
            <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="#FFF3F3F3" />
            <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#FF4D4D4D" />
            <!-- Other app resources here -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
