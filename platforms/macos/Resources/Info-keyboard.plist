<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Supplementary Info.plist for the Byakaron Keyboard (input method) target.

     Only the keys Xcode CANNOT derive from build settings live here — the
     InputMethodKit / Text Input Source keys that make macOS recognise this bundle
     as a Bangla keyboard input source. Everything else (CFBundleIdentifier,
     CFBundleExecutable, CFBundleVersion, LSUIElement, NSPrincipalClass, …) is
     generated by GENERATE_INFOPLIST_FILE = YES and merged on top of this file.

     IMPORTANT: TISInputSourceID / CFBundleIdentifier must contain the
     `inputmethod` token (e.g. dev.nuhu.labs.inputmethod.Byakaron); macOS won't
     list the keyboard in Input Sources without it. The bundle id is set via the
     target's PRODUCT_BUNDLE_IDENTIFIER. -->
<plist version="1.0">
<dict>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>InputMethodConnectionName</key>
    <string>dev.nuhu.labs.inputmethod.Byakaron_Connection</string>
    <!-- Bare Objective-C runtime name (the controller is declared
         @objc(ByakaronInputController)), so this resolves regardless of the
         Swift module name — the target's module is "Byakaron_Keyboard", not
         "Byakaron", so a module-qualified name here would NOT load. -->
    <key>InputMethodServerControllerClass</key>
    <string>ByakaronInputController</string>
    <key>TISInputSourceID</key>
    <string>dev.nuhu.labs.inputmethod.Byakaron</string>
    <key>TISIntendedLanguage</key>
    <string>bn</string>
    <key>TISIconIsTemplate</key>
    <true/>
    <key>tsInputMethodCharacterRepertoireKey</key>
    <array>
        <string>Beng</string>
    </array>
    <key>tsInputMethodIconFileKey</key>
    <string>iconTemplate</string>
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSLanguages</key>
            <array>
                <string>bn</string>
            </array>
            <key>NSSpellChecker</key>
            <string>Byakaron</string>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Byakaron Bangla Spelling</string>
            </dict>
            <key>NSExecutable</key>
            <string>Byakaron Keyboard</string>
        </dict>
    </array>
</dict>
</plist>
