{
    "app-id": "dev.nuhu.labs.Byakaron",
    "runtime": "org.gnome.Platform",
    "runtime-version": "49",
    "sdk": "org.gnome.Platform",
    "command": "byakaron",
    "finish-args": [
        "--share=ipc",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--device=dri",
        "--talk-name=ca.desrt.dconf",
        "--filesystem=xdg-run/dconf",
        "--talk-name=org.freedesktop.portal.Desktop"
    ],
    "modules": [
        {
            "name": "byakaron",
            "buildsystem": "simple",
            "build-commands": [
                "install -D -m 755 byakaron /app/bin/byakaron",
                "install -D -m 644 dev.nuhu.labs.Byakaron.desktop /app/share/applications/dev.nuhu.labs.Byakaron.desktop",
                "install -D -m 644 dev.nuhu.labs.Byakaron.metainfo.xml /app/share/metainfo/dev.nuhu.labs.Byakaron.metainfo.xml",
                "install -D -m 644 byakaron.png /app/share/icons/hicolor/128x128/apps/dev.nuhu.labs.Byakaron.png"
            ],
            "sources": [
                {
                    "type": "file",
                    "path": "byakaron"
                },
                {
                    "type": "file",
                    "path": "dev.nuhu.labs.Byakaron.desktop"
                },
                {
                    "type": "file",
                    "path": "dev.nuhu.labs.Byakaron.metainfo.xml"
                },
                {
                    "type": "file",
                    "path": "byakaron.png"
                }
            ]
        }
    ]
}
